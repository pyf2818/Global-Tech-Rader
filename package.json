    "pg": "^8.16.3",
    "postcss": "^8.5.15",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-globe.gl": "^2.38.0",
    "react-i18next": "^17.0.11",
    "tailwindcss": "^3.4.17",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",

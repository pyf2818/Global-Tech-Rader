    "verify:platform": "node scripts/verify-platform.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "^10.5.0",
    "i18next": "^26.3.6",

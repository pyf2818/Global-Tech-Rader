# 环境配置文件
# 复制此文件为 .env 并根据需要修改配置

# ======================
# Flask 配置
# ======================
FLASK_ENV=production
FLASK_DEBUG=0

# ======================
# Scrapling 配置
# ======================
SCRAPLING_PORT=5000
SCRAPLING_TIMEOUT=120
SCRAPLING_MAX_WORKERS=4

# ======================
# 前端配置
# ======================
VITE_API_URL=http://localhost:5000
NODE_ENV=production

# ======================
# PostgreSQL（认证、社区、画像与快照持久化）
# ======================
DB_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://meridian:replace_with_a_long_random_password@localhost:5433/silicon_meridian

# ======================
# 可选：Redis 配置（如果使用 Redis）
# ======================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ======================
# 可选：代理配置（如果需要使用代理）
# ======================
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# ======================
# 安全配置（生产环境建议设置）
# ======================
# API_KEY=your_api_key_here
# ALLOWED_ORIGINS=http://localhost:80,https://yourdomain.com
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_PERIOD=3600

# ======================
# 日志配置
# ======================
# LOG_LEVEL=info
# LOG_FILE=/var/log/scrapling/app.log
# ACCESS_LOG=/var/log/scrapling/access.log
# ERROR_LOG=/var/log/scrapling/error.log
